<stack class="page"><stack class="surface" if="{{ready}}" style="width:{{w}}px;height:{{h}}px;">
<div class="header" style="left:{{hx}}px;top:{{hy}}px;width:{{hw}}px;height:{{hit}}px;">
<div class="hit" style="width:{{hit}}px;height:{{hit}}px;" @click="back"><image src="/common/icons/back_warm.png" style="width:{{rowIcon}}px;height:{{rowIcon}}px;"></image></div>
<text class="head-title" style="width:{{headCenterW}}px;height:{{hit}}px;font-size:{{headFont}}px;">{{headerTitle}}</text></div>
<div class="section" style="left:{{contentX}}px;top:{{newY}}px;width:{{contentW}}px;height:{{hit}}px;">
<div class="hit" style="width:{{hit}}px;height:{{hit}}px;" @click="monthPrev"><image src="/common/icons/back_warm.png" style="width:{{rowIcon}}px;height:{{rowIcon}}px;"></image></div>
<text class="head-title" style="width:{{contentW-2*hit}}px;height:{{hit}}px;font-size:{{monthFont}}px;">{{monthLabel}}</text>
<div class="hit" style="width:{{hit}}px;height:{{hit}}px;" @click="monthNext"><image src="/common/icons/right_warm.png" style="width:{{rowIcon}}px;height:{{rowIcon}}px;"></image></div></div>
<list class="note-list" ref="crown" style="left:{{contentX}}px;top:{{listY}}px;width:{{contentW}}px;height:{{listH}}px;" @swipe="onSwipe" @scrollend="onScrollEnd">
<list-item class="row" for="{{rows}}" tid="id" style="width:{{contentW}}px;height:{{rowH}}px;" @click="open($item)">
<div class="day-row" style="width:{{contentW}}px;height:{{rowCopyH}}px;">
<text class="day-num" style="width:{{dayNumW}}px;height:{{dayNumH}}px;font-size:{{dayNumFont}}px;">{{$item.num}}</text>
<div class="copy" style="width:{{dayCopyW}}px;height:{{rowCopyH}}px;margin-left:{{dayGap}}px;">
<text class="row-title" style="width:{{dayCopyW}}px;height:{{titleH}}px;font-size:{{titleFont}}px;">{{$item.title}}</text>
<text class="row-meta" style="width:{{dayCopyW}}px;height:{{metaH}}px;font-size:{{metaFont}}px;margin-top:{{copyGap}}px;">{{$item.meta}}</text></div>
<image src="/common/icons/right_warm.png" style="width:{{rowIcon}}px;height:{{rowIcon}}px;margin-left:{{dayGap}}px;"></image></div></list-item>
<list-item if="{{hasMore || hasPrev}}" class="pager" style="width:{{contentW}}px;height:{{hit}}px;">
<div class="hit" if="{{hasPrev}}" style="width:{{contentW/2}}px;height:{{hit}}px;" @click="prev"><text class="pager-text">&#x4E0A;&#x4E00;&#x5C4F;</text></div>
<div class="hit" if="{{hasMore}}" style="width:{{contentW/2}}px;height:{{hit}}px;" @click="next"><text class="pager-text">&#x4E0B;&#x4E00;&#x5C4F;</text></div></list-item>
</list>
<div class="notice" if="{{message || loading}}" style="left:{{contentX}}px;top:{{listY}}px;width:{{contentW}}px;height:{{listH}}px;" @click="retry"><text class="quiet" style="width:{{contentW}}px;height:{{quietH}}px;font-size:{{quietFont}}px;">{{message || '&#x6B63;&#x5728;&#x8BFB;&#x53D6;'}}</text></div>
<div class="quiet-empty" if="{{empty && !message && !loading}}" style="left:{{emptyX}}px;top:{{emptyY}}px;width:{{emptyW}}px;height:{{emptyH}}px;">
<image src="{{'/common/icons/'+emptyIcon+'_gold.png'}}" style="width:{{emptyIconSize}}px;height:{{emptyIconSize}}px;margin-bottom:{{emptyIconGap}}px;"></image>
<text class="empty-title" style="width:{{emptyW}}px;height:{{emptyTitleH}}px;font-size:{{emptyTitleFont}}px;margin-bottom:{{emptyTitleGap}}px;">{{emptyText}}</text>
<text class="empty-prompt" style="width:{{emptyW}}px;height:{{emptyPromptH}}px;font-size:{{emptyPromptFont}}px;">{{emptyPrompt}}</text></div>
<div class="dock" style="left:{{dockX}}px;top:{{dockY}}px;width:{{dockW}}px;height:{{hit}}px;border-radius:{{dockRadius}}px;">
<div class="nav" style="width:{{dockHalfW}}px;height:{{dockInnerH}}px;" @click="home"><image src="/common/icons/book_nav_muted.png" style="width:20px;height:20px;margin-right:{{navGap}}px;"></image><text class="nav-label" style="width:{{navFont*2}}px;height:{{28*w/412}}px;font-size:{{navFont}}px;">&#x968F;&#x8BB0;</text></div>
<div class="dock-divider" style="width:1px;height:{{dockInnerH}}px;"></div>
<div class="nav" style="width:{{dockHalfW}}px;height:{{dockInnerH}}px;" @click="history"><image src="/common/icons/calendar_nav_gold.png" style="width:20px;height:20px;margin-right:{{navGap}}px;"></image><text class="selected" style="width:{{navFont*2}}px;height:{{28*w/412}}px;font-size:{{navFont}}px;">&#x56DE;&#x770B;</text></div></div>
</stack><div class="loading" if="{{!ready}}" @click="retry"><text class="quiet">{{message}}</text></div></stack>
