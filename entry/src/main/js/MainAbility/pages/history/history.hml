<stack class="page"><div class="loading" if="{{!ready}}" @click="retry"><text class="message" style="width:{{loadW}};height:{{loadH}};font-size:18px;">{{message}}</text></div><stack class="surface" if="{{ready}}" style="width:{{w}};height:{{h}};">
<slider class="crown-sensor" ref="crown" min="0" max="100" value="{{crownValue}}" @change="crownChange"></slider>
<div class="header" style="left:{{hx}};top:{{hy}};width:{{hw}};height:{{hit}};"><div class="hit" @click="back" style="width:{{hit}};height:{{hit}};"><image src="/common/ui/back-warm.png" style="width:23px;height:23px;"></image></div><text class="head-title" style="width:{{headTextW}};height:{{hit}};font-size:{{headFont}};">{{heading}}</text></div><div class="month-row" style="left:{{contentX}};top:{{newY}};width:{{contentW}};height:{{hit}};"><div class="hit" @click="prevMonth" style="width:{{hit}};height:{{hit}};"><image src="/common/ui/back-warm.png" style="width:23px;height:23px;"></image></div><text class="head-title" style="width:{{monthW}};height:{{hit}};font-size:{{monthFont}};">{{monthText}}</text><div class="hit" @click="nextMonth" style="width:{{hit}};height:{{hit}};"><image src="/common/ui/right-muted.png" style="width:23px;height:23px;"></image></div></div><list class="note-list" @swipe="onSwipe" style="left:{{contentX}};top:{{listY}};width:{{contentW}};height:{{listH}};"><list-item class="day-row" for="{{(i,r) in rows}}" @click="openDay(r)" style="width:{{contentW}};height:{{rowH}};"><text class="day-number" style="width:{{dayNumberW}};height:{{rowH}};font-size:{{dayNumberFont}};">{{r.number}}</text><div class="row-copy" style="width:{{dayCopyW}};height:{{rowH}};margin-left:{{10*w/412}};"><text class="row-title" style="width:{{dayCopyW}};height:{{dayTitleH}};font-size:{{dayFont}};">{{r.label}}</text><text class="row-meta" style="width:{{dayCopyW}};height:{{metaH}};font-size:{{metaFont}};margin-top:{{lineGap}};">{{r.meta}}</text></div><image src="/common/ui/right-muted.png" style="width:{{iconSize}};height:{{iconSize}};"></image></list-item></list><div class="empty" if="{{empty && !error}}" style="left:{{contentX}};top:{{emptyY}};width:{{contentW}};height:{{emptyH}};"><text class="empty-title" style="width:{{contentW}};height:{{emptyTitleH}};font-size:{{emptyFont}};">{{emptyTitle}}</text><text class="empty-hint" style="width:{{contentW}};height:{{emptyHintH}};font-size:{{metaFont}};">{{emptyHint}}</text></div><text class="message" if="{{error}}" @click="retry" style="left:{{contentX}};top:{{listY}};width:{{contentW}};height:{{listH}};font-size:18px;">{{message}}</text><div class="swipe-plane" @swipe="onSwipe" style="left:0px;top:{{listY}};width:0px;height:{{listH}};"></div><div class="dock" style="left:{{dockX}};top:{{dockY}};width:{{dockW}};height:{{hit}};border-radius:{{dockRadius}};"><div class="dock-button" @click="home" style="width:{{dockButtonW}};height:{{hit-2}};"><image src="{{homeIcon}}" style="width:20px;height:20px;margin-right:{{dockGap}};"></image><text class="dock-label" style="width:{{dockTextW}};height:{{dockFont*1.4}};font-size:{{dockFont}};color:{{homeColor}};">&#x968F;&#x8BB0;</text></div><div class="dock-divider" style="height:{{hit-2}};"></div><div class="dock-button" @click="history" style="width:{{dockButtonW}};height:{{hit-2}};"><image src="{{historyIcon}}" style="width:20px;height:20px;margin-right:{{dockGap}};"></image><text class="dock-label" style="width:{{dockTextW}};height:{{dockFont*1.4}};font-size:{{dockFont}};color:{{historyColor}};">&#x56DE;&#x770B;</text></div></div></stack></stack>
