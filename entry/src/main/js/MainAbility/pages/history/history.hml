<stack class="page"><div class="loading" if="{{!ready}}" @click="retry"><text class="message" style="width:{{loadW}}px;height:{{loadH}}px;font-size:18px;">{{message}}</text></div><stack class="surface" if="{{ready}}" style="width:{{w}}px;height:{{h}}px;">
<slider class="crown-sensor" ref="crown" min="0" max="100" value="{{crownValue}}" @change="crownChange"></slider>
<div class="header" style="left:{{hx}}px;top:{{hy}}px;width:{{hw}}px;height:{{hit}}px;"><div class="hit" @click="back" style="width:{{hit}}px;height:{{hit}}px;"><image src="/common/ui/back-warm.png" style="width:23px;height:23px;"></image></div><text class="head-title" style="width:{{headTextW}}px;height:{{hit}}px;font-size:{{headFont}}px;">{{heading}}</text></div><div class="month-row" style="left:{{contentX}}px;top:{{newY}}px;width:{{contentW}}px;height:{{hit}}px;"><div class="hit" @click="prevMonth" style="width:{{hit}}px;height:{{hit}}px;"><image src="/common/ui/back-warm.png" style="width:23px;height:23px;"></image></div><text class="head-title" style="width:{{monthW}}px;height:{{hit}}px;font-size:{{monthFont}}px;">{{monthText}}</text><div class="hit" @click="nextMonth" style="width:{{hit}}px;height:{{hit}}px;"><image src="/common/ui/right-muted.png" style="width:23px;height:23px;"></image></div></div><list class="note-list" @swipe="onSwipe" style="left:{{contentX}}px;top:{{listY}}px;width:{{contentW}}px;height:{{listH}}px;"><list-item class="day-row" for="{{(i,r) in rows}}" @click="openDay(r)" style="width:{{contentW}}px;height:{{rowH}}px;"><text class="day-number" style="width:{{dayNumberW}}px;height:{{rowH}}px;font-size:{{dayNumberFont}}px;">{{r.number}}</text><div class="row-copy" style="width:{{dayCopyW}}px;height:{{rowH}}px;margin-left:{{10*w/412}}px;"><text class="row-title" style="width:{{dayCopyW}}px;height:{{dayTitleH}}px;font-size:{{dayFont}}px;">{{r.label}}</text><text class="row-meta" style="width:{{dayCopyW}}px;height:{{metaH}}px;font-size:{{metaFont}}px;margin-top:{{lineGap}}px;">{{r.meta}}</text></div><image src="/common/ui/right-muted.png" style="width:{{iconSize}}px;height:{{iconSize}}px;"></image></list-item></list><div class="empty" if="{{empty && !error}}" style="left:{{contentX}}px;top:{{emptyY}}px;width:{{contentW}}px;height:{{emptyH}}px;"><text class="empty-title" style="width:{{contentW}}px;height:{{emptyTitleH}}px;font-size:{{emptyFont}}px;">{{emptyTitle}}</text><text class="empty-hint" style="width:{{contentW}}px;height:{{emptyHintH}}px;font-size:{{metaFont}}px;">{{emptyHint}}</text></div><text class="message" if="{{error}}" @click="retry" style="left:{{contentX}}px;top:{{listY}}px;width:{{contentW}}px;height:{{listH}}px;font-size:18px;">{{message}}</text><div class="swipe-plane" @swipe="onSwipe" style="left:0px;top:{{listY}}px;width:0px;height:{{listH}}px;"></div><div class="dock" style="left:{{dockX}}px;top:{{dockY}}px;width:{{dockW}}px;height:{{hit}}px;border-radius:{{dockRadius}}px;"><div class="dock-button" @click="home" style="width:{{dockButtonW}}px;height:{{hit-2}}px;"><image src="{{homeIcon}}" style="width:20px;height:20px;margin-right:{{dockGap}}px;"></image><text class="dock-label" style="width:{{dockTextW}}px;height:{{dockFont*1.4}}px;font-size:{{dockFont}}px;color:{{homeColor}};">&#x968F;&#x8BB0;</text></div><div class="dock-divider" style="height:{{hit-2}}px;"></div><div class="dock-button" @click="history" style="width:{{dockButtonW}}px;height:{{hit-2}}px;"><image src="{{historyIcon}}" style="width:20px;height:20px;margin-right:{{dockGap}}px;"></image><text class="dock-label" style="width:{{dockTextW}}px;height:{{dockFont*1.4}}px;font-size:{{dockFont}}px;color:{{historyColor}};">&#x56DE;&#x770B;</text></div></div></stack></stack>
