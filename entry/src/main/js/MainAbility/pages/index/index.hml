<stack class="page"><div class="loading" if="{{!ready}}" @click="retry"><text class="message" style="width:{{loadW}};height:{{loadH}};font-size:18px;">{{message}}</text></div><stack class="surface" if="{{ready}}" style="width:{{w}};height:{{h}};">
<slider class="crown-sensor" ref="crown" min="0" max="100" value="{{crownValue}}" @change="crownChange"></slider>
<div class="header" style="left:{{hx}};top:{{hy}};width:{{hw}};height:{{hit}};"><image src="/common/ui/app-name.png" style="width:{{brandW}};height:{{brandH}};"></image><text class="date" style="width:{{headDateW}};height:{{hit}};font-size:{{dateFont}};">{{dateText}}</text><div class="hit" @click="appMenu" style="width:{{hit}};height:{{hit}};"><image src="/common/ui/dots-warm.png" style="width:23px;height:23px;"></image></div></div><div class="new-note" @click="newNote" style="left:{{contentX}};top:{{newY}};width:{{contentW}};height:{{newH}};border-radius:{{newRadius}};"><image src="/common/ui/plus-ink.png" style="width:{{plusSize}};height:{{plusSize}};margin-left:{{newPad}};"></image><image src="/common/ui/write-note.png" style="width:{{writeW}};height:{{writeH}};margin-left:{{newGap}};"></image></div><div class="section" style="left:{{contentX}};top:{{sectionY}};width:{{contentW}};height:44px;"><text class="section-text" style="width:{{sectionTextW}};height:{{sectionFont*1.5}};font-size:{{sectionFont}};">{{sectionText}}</text><div class="hit" @click="togglePinned" style="width:{{filterW}};height:44px;"><text class="filter" style="width:{{filterW}};height:{{filterFont*1.5}};font-size:{{filterFont}};color:{{filterColor}};">&#x7F6E;&#x9876;</text></div></div><list class="note-list" @swipe="onSwipe" style="left:{{contentX}};top:{{listY}};width:{{contentW}};height:{{listH}};">
<list-item class="note-row" for="{{(i,r) in rows}}" @click="openRow(r)" style="width:{{contentW}};height:{{rowH}};">
<stack style="width:{{contentW}};height:{{rowH}};">
<div class="row-copy" style="left:{{rowPad}};top:{{(rowH-titleH-metaH-lineGap)/2}};width:{{rowTextW}};height:{{titleH+metaH+lineGap}};">
<div class="title-row" style="width:{{rowTextW}};height:{{titleH}};"><image if="{{r.pinned}}" src="/common/ui/pin-gold.png" style="width:{{pinSize}};height:{{pinSize}};margin-right:{{pinGap}};"></image><text class="row-title" style="width:{{rowTextW-(r.pinned?pinSize+pinGap:0)}};height:{{titleH}};font-size:{{rowFont}};">{{r.title}}</text></div>
<text class="row-meta" style="width:{{rowTextW}};height:{{metaH}};font-size:{{metaFont}};margin-top:{{lineGap}};">{{r.meta}}</text></div>
<div class="divider" style="left:0px;top:{{rowH-1}};width:{{contentW}};height:1px;"></div></stack></list-item></list><div class="quiet-status" if="{{empty && !error}}" style="left:{{contentX}};top:{{listY+16+16*w/412}};width:{{contentW}};height:{{33*w/412}};"><text class="quiet-text" style="width:{{contentW}};height:{{33*w/412}};font-size:{{19*w/412}};">{{emptyTitle}}</text></div><text class="message" if="{{error}}" style="left:{{contentX}};top:{{listY}};width:{{contentW}};height:{{listH}};">{{message}}</text><div class="swipe-plane" @swipe="onSwipe" style="left:0px;top:{{listY}};width:0px;height:{{listH}};"></div><div class="dock" style="left:{{dockX}};top:{{dockY}};width:{{dockW}};height:{{hit}};border-radius:{{dockRadius}};"><div class="dock-button" @click="home" style="width:{{dockButtonW}};height:{{hit-2}};"><image src="{{homeIcon}}" style="width:20px;height:20px;margin-right:{{dockGap}};"></image><text class="dock-label" style="width:{{dockTextW}};height:{{dockFont*1.4}};font-size:{{dockFont}};color:{{homeColor}};">&#x968F;&#x8BB0;</text></div><div class="dock-divider" style="height:{{hit-2}};"></div><div class="dock-button" @click="history" style="width:{{dockButtonW}};height:{{hit-2}};"><image src="{{historyIcon}}" style="width:20px;height:20px;margin-right:{{dockGap}};"></image><text class="dock-label" style="width:{{dockTextW}};height:{{dockFont*1.4}};font-size:{{dockFont}};color:{{historyColor}};">&#x56DE;&#x770B;</text></div></div></stack></stack>
