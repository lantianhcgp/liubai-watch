<stack class="page">
 <div class="loading" if="{{!ready}}" @click="retry"><text class="notice">{{message}}</text></div>
 <stack class="surface" if="{{ready}}" style="width:{{w}}px;height:{{h}}px;">
  <slider class="crown-sensor" ref="crown" min="0" max="100" value="{{crownValue}}" @change="crownChange"></slider>
  <text class="line" for="{{(i,line) in lines}}" style="left:{{line.x}}px;top:{{line.y}}px;width:{{line.width}}px;height:{{line.height}}px;font-size:{{line.font}}px;">{{line.text}}</text>
  <text class="placeholder" if="{{empty}}" style="left:{{placeholderX}}px;top:{{placeholderY}}px;width:{{placeholderW}}px;height:{{lineHeight}}px;font-size:{{font}}px;">&#x5199;&#x4E0B;&#x73B0;&#x5728;&#x7684;&#x5FF5;&#x5934;</text>
  <div class="caret" if="{{caretShow}}" style="left:{{caretX}}px;top:{{caretY}}px;height:{{caretH}}px;"></div>
  <div class="body-hit" @click="pickLine" @touchstart="bodyStart" @touchend="bodyEnd" @touchcancel="bodyCancel" @swipe="bodySwipe" style="left:0px;top:{{top}}px;width:{{w}}px;height:{{bottom-top}}px;"></div>
  <div class="header" style="left:{{hx}}px;top:{{hy}}px;width:{{hw}}px;height:46px;">
   <div class="command" @click="cancel"><text class="cancel">&#x53D6;&#x6D88;</text></div>
   <div class="middle" if="{{!open}}" style="width:{{middleW}}px;"><text class="title" style="width:{{middleW}}px;">{{title}}</text></div>
   <div class="command" if="{{open}}" @click="toggle"><image class="icon" src="/common/ui/collapse-muted.png"></image></div>
   <div class="command" if="{{open}}" @click="tools"><image class="icon" src="/common/ui/dots-warm.png"></image></div>
   <div class="command" @click="save" style="width:{{doneW}}px;"><text class="done" style="width:{{doneW}}px;">{{doneLabel}}</text></div>
  </div>
  <text class="status" style="left:{{statusX}}px;top:{{statusY}}px;width:{{statusW}}px;">{{status}}</text>
  <text class="composing" if="{{open && hasPinyin}}" style="left:{{statusX}}px;top:{{statusY}}px;width:{{statusW}}px;">{{composition}}</text>
  <stack class="key-viewport" if="{{open}}" style="left:{{keyX}}px;top:{{keysY}}px;width:{{keyW}}px;height:141px;">
   <image class="key-sheet" src="{{image}}" @click="tapKey" @touchstart="startKey" @touchmove="moveKey" @touchend="endKey" @touchcancel="cancelKey" @longpress="longKey" style="left:{{sheetOffset}}px;top:0px;width:{{sheetW}}px;height:141px;"></image>
  </stack>
  <div class="keybar" if="{{open && !hasPinyin}}" style="left:{{footX}}px;top:{{footY}}px;width:{{footW}}px;height:44px;">
   <div class="mode-key" @click="mode"><image class="mode-image" src="{{typeImage}}"></image></div>
   <div class="space-key" @click="space" style="width:{{spaceW}}px;"><image class="space-image" src="{{spaceImage}}" style="width:{{spaceW}}px;"></image></div>
   <div class="small-key" @click="del"><image class="icon" src="/common/ui/delete-warm.png"></image></div>
   <div class="small-key" @click="enter"><image class="icon" src="/common/ui/enter-warm.png"></image></div>
  </div>
  <div class="candidate-keybar" if="{{open && hasPinyin}}" style="left:{{footX}}px;top:{{footY}}px;width:{{footW}}px;height:44px;">
   <list class="candidate-list" style="width:{{footW-49}}px;height:44px;"><list-item class="candidate" for="{{(i,c) in candidates}}" @click="choose(i)" style="width:{{c.width}}px;height:44px;"><text class="candidate-text" style="width:{{c.width}}px;color:{{i===0?'#70b5ff':'#f1f0e8'}};">{{c.text}}</text></list-item></list>
   <div class="small-key" @click="del"><image class="icon" src="/common/ui/delete-warm.png"></image></div>
  </div>
  <div class="folded-bar" if="{{!open}}" style="left:{{footX}}px;top:{{footY}}px;width:{{footW}}px;height:44px;">
   <div class="fold-nav" @click="prev" style="opacity:{{canPrev?1:0.4}};"><image class="icon" src="/common/ui/back-muted.png"></image></div>
   <div class="expand" @click="toggle" style="width:{{footW-100}}px;"><text class="expand-label">&#x5C55;&#x5F00;&#x952E;&#x76D8;</text></div>
   <div class="fold-nav" @click="next" style="opacity:{{canNext?1:0.4}};"><image class="icon" src="/common/ui/right-muted.png"></image></div>
  </div>
  <text class="error" if="{{!!message}}" style="left:{{hx}}px;top:{{hy+46}}px;width:{{hw}}px;">{{message}}</text>
 </stack>
</stack>
