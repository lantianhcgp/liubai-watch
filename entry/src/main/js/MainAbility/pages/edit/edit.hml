<stack class="page">
 <div class="loading" if="{{!ready}}" @click="retry"><text class="notice">{{message}}</text></div>
 <stack class="surface" if="{{ready}}" style="width:{{w}};height:{{h}};">
  <slider class="crown-sensor" ref="crown" min="0" max="100" value="{{crownValue}}" @change="crownChange"></slider>
  <text class="line" for="{{(i,line) in lines}}" style="left:{{line.x}};top:{{line.y}};width:{{line.width}};height:{{line.height}};font-size:{{line.font}};">{{line.text}}</text>
  <text class="placeholder" if="{{empty}}" style="left:{{placeholderX}};top:{{placeholderY}};width:{{placeholderW}};height:{{lineHeight}};font-size:{{font}};">&#x5199;&#x4E0B;&#x73B0;&#x5728;&#x7684;&#x5FF5;&#x5934;</text>
  <div class="caret" if="{{caretShow}}" style="left:{{caretX}};top:{{caretY}};height:{{caretH}};"></div>
  <div class="body-hit" @click="pickLine" @touchstart="bodyStart" @touchend="bodyEnd" @swipe="bodySwipe" style="left:0px;top:{{top}};width:{{w}};height:{{bottom-top}};"></div>
  <div class="header" style="left:{{hx}};top:{{hy}};width:{{hw}};height:46px;">
   <div class="command" @click="cancel"><text class="cancel">&#x53D6;&#x6D88;</text></div>
   <div class="middle" if="{{!open}}" style="width:{{middleW}};"><text class="title" style="width:{{middleW}};">{{title}}</text></div>
   <div class="command" if="{{open}}" @click="toggle"><image class="icon" src="/common/ui/collapse-muted.png"></image></div>
   <div class="command" if="{{open}}" @click="tools"><image class="icon" src="/common/ui/dots-warm.png"></image></div>
   <div class="command" @click="save" style="width:{{doneW}};"><text class="done" style="width:{{doneW}};">{{doneLabel}}</text></div>
  </div>
  <text class="status" style="left:{{statusX}};top:{{statusY}};width:{{statusW}};">{{status}}</text>
  <text class="composing" if="{{open && hasPinyin}}" style="left:{{statusX}};top:{{statusY}};width:{{statusW}};">{{composition}}</text>
  <stack class="key-viewport" if="{{open}}" style="left:{{keyX}};top:{{keysY}};width:{{keyW}};height:141px;">
   <image class="key-sheet" src="{{image}}" @click="tapKey" @touchstart="startKey" @touchmove="moveKey" @touchend="endKey" @longpress="longKey" style="left:{{sheetOffset}};top:0px;width:{{sheetW}};height:141px;"></image>
  </stack>
  <div class="keybar" if="{{open && !hasPinyin}}" style="left:{{footX}};top:{{footY}};width:{{footW}};height:44px;">
   <div class="mode-key" @click="mode"><image class="mode-image" src="{{typeImage}}"></image></div>
   <div class="space-key" @click="space" style="width:{{spaceW}};"><image class="space-image" src="{{spaceImage}}" style="width:{{spaceW}};"></image></div>
   <div class="small-key" @click="del"><image class="icon" src="/common/ui/delete-warm.png"></image></div>
   <div class="small-key" @click="enter"><image class="icon" src="/common/ui/enter-warm.png"></image></div>
  </div>
  <div class="candidate-keybar" if="{{open && hasPinyin}}" style="left:{{footX}};top:{{footY}};width:{{footW}};height:44px;">
   <list class="candidate-list" style="width:{{footW-49}};height:44px;"><list-item class="candidate" for="{{(i,c) in candidates}}" @click="choose(i)" style="width:{{c.width}};height:44px;"><text class="candidate-text" style="width:{{c.width}};color:{{i===0?'#70b5ff':'#f1f0e8'}};">{{c.text}}</text></list-item></list>
   <div class="small-key" @click="del"><image class="icon" src="/common/ui/delete-warm.png"></image></div>
  </div>
  <div class="folded-bar" if="{{!open}}" style="left:{{footX}};top:{{footY}};width:{{footW}};height:44px;">
   <div class="fold-nav" @click="prev" style="opacity:{{canPrev?1:0.4}};"><image class="icon" src="/common/ui/back-muted.png"></image></div>
   <div class="expand" @click="toggle" style="width:{{footW-100}};"><text class="expand-label">&#x5C55;&#x5F00;&#x952E;&#x76D8;</text></div>
   <div class="fold-nav" @click="next" style="opacity:{{canNext?1:0.4}};"><image class="icon" src="/common/ui/right-muted.png"></image></div>
  </div>
  <text class="error" if="{{!!message}}" style="left:{{hx}};top:{{hy+46}};width:{{hw}};">{{message}}</text>
 </stack>
</stack>
