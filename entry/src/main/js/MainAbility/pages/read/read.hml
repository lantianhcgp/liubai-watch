<stack class="page">
  <div class="loading" if="{{!ready}}" @click="retry"><text class="notice">{{message}}</text></div>
  <stack class="surface" if="{{ready}}" style="width:{{w}};height:{{h}};">
    <slider class="crown-sensor" ref="crown" min="0" max="100" value="{{crownValue}}" @change="crownChange"></slider>
    <text class="reading-line" for="{{(i,line) in lines}}" style="left:{{line.x}};top:{{line.y}};width:{{line.width}};height:{{line.height}};font-size:{{line.font}};">{{line.text}}</text>
    <div for="{{(i,line) in lines}}" style="left:{{line.x+0.45}};top:{{line.y}};width:{{line.width-0.45}};height:{{line.height}};"><text class="reading-line" if="{{line.bold}}" style="width:{{line.width-0.45}};height:{{line.height}};font-size:{{line.font}};">{{line.text}}</text></div>
    <div class="body-hit" @touchstart="startTouch" @touchend="endTouch" @swipe="onSwipe" style="left:0px;top:{{top}};width:{{w}};height:{{bottom-top}};"></div>
    <div class="header" style="left:{{hx}};top:{{hy}};width:{{hw}};height:{{hit}};">
      <div class="hit" @click="back" style="width:{{hit}};height:{{hit}};"><image class="icon" src="/common/ui/back-warm.png"></image></div>
      <div class="date-box" style="width:{{hw-2*hit}};height:{{hit}};"><text class="date">{{date}}</text><text class="time">{{time}}</text></div>
      <div class="hit" @click="more" style="width:{{hit}};height:{{hit}};"><image class="more-icon" src="/common/ui/dots-gold.png"></image></div>
    </div>
    <text class="counter" style="left:{{trackX}};top:{{footerY}};width:{{trackW}};">{{counter}}</text>
    <div class="track" style="left:{{trackX}};top:{{footerY+20}};width:{{trackW}};"><div class="progress" style="width:{{progressW}};"></div></div>
  </stack>
</stack>
