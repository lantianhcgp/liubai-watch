<stack class="page"><div class="loading" if="{{!ready}}" @click="retry"><text class="message" style="width:{{loadW}};height:{{loadH}};font-size:18px;">{{message}}</text></div><stack class="surface" if="{{ready}}" style="width:{{w}};height:{{h}};">
<slider class="crown-sensor" ref="crown" min="0" max="100" value="{{crownValue}}" @change="crownChange"></slider>
<div class="header" style="left:{{hx}};top:{{hy}};width:{{hw}};height:{{hit}};"><div class="hit" @click="back" style="width:{{hit}};height:{{hit}};"><image src="/common/ui/back-warm.png" style="width:23px;height:23px;"></image></div><text class="head-title" style="width:{{headTextW}};height:{{hit}};font-size:{{headFont}};">{{heading}}</text></div><list class="note-list" @swipe="onSwipe" style="left:{{contentX}};top:{{listY}};width:{{contentW}};height:{{listH}};">
<list-item class="note-row" for="{{(i,r) in rows}}" @click="openRow(r)" style="width:{{contentW}};height:{{rowH}};">
<stack style="width:{{contentW}};height:{{rowH}};">
<div class="row-copy" style="left:{{rowPad}};top:{{(rowH-titleH-metaH-lineGap)/2}};width:{{rowTextW}};height:{{titleH+metaH+lineGap}};">
<div class="title-row" style="width:{{rowTextW}};height:{{titleH}};"><image if="{{r.pinned}}" src="/common/ui/pin-gold.png" style="width:{{pinSize}};height:{{pinSize}};margin-right:{{pinGap}};"></image><text class="row-title" style="width:{{rowTextW-(r.pinned?pinSize+pinGap:0)}};height:{{titleH}};font-size:{{rowFont}};">{{r.title}}</text></div>
<text class="row-meta" style="width:{{rowTextW}};height:{{metaH}};font-size:{{metaFont}};margin-top:{{lineGap}};">{{r.meta}}</text></div>
<div class="divider" style="left:0px;top:{{rowH-1}};width:{{contentW}};height:1px;"></div></stack></list-item></list><div class="empty" if="{{empty && !error}}" style="left:{{contentX}};top:{{emptyY}};width:{{contentW}};height:{{emptyH}};"><text class="empty-title" style="width:{{contentW}};height:{{emptyTitleH}};font-size:{{emptyFont}};">{{emptyTitle}}</text><text class="empty-hint" style="width:{{contentW}};height:{{emptyHintH}};font-size:{{metaFont}};">{{emptyHint}}</text></div><text class="message" if="{{error}}" @click="retry" style="left:{{contentX}};top:{{listY}};width:{{contentW}};height:{{listH}};font-size:18px;">{{message}}</text><div class="swipe-plane" @swipe="onSwipe" style="left:0px;top:{{listY}};width:0px;height:{{listH}};"></div><div class="dock" @click="home" style="left:{{dockX}};top:{{dockY}};width:{{dockW}};height:{{hit}};border-radius:{{dockRadius}};justify-content:center;"><image src="/common/ui/back-warm.png" style="width:23px;height:23px;margin-right:{{dockGap}};"></image><text class="dock-label" style="height:{{dockFont*1.4}};font-size:{{dockFont}};color:#adb1a9;">&#x8FD4;&#x56DE;&#x968F;&#x8BB0;</text></div></stack></stack>
