<stack class="page">
 <div class="loading" if="{{!ready}}" @click="retry"><text class="notice">{{message}}</text></div>
 <stack class="surface" if="{{ready}}" style="width:{{w}};height:{{h}};">
  <div class="header" style="left:{{hx}};top:{{hy}};width:{{hw}};height:{{hit}};">
   <div class="hit" @click="back" style="width:{{hit}};height:{{hit}};"><image class="icon" src="/common/ui/back-warm.png"></image></div>
   <text class="title" style="width:{{titleW}};height:{{hit}};font-size:{{titleFont}};">{{title}}</text>
   <div class="hit" style="width:{{hit}};height:{{hit}};"></div>
  </div>
  <list class="menu-list" ref="crown" style="left:{{contentX}};top:{{top}};width:{{contentW}};height:{{listH}};">
   <list-item if="{{isReadOptions}}" class="font-block" style="width:{{contentW}};height:{{fontBlockH}};"><text class="font-heading" style="width:{{contentW}};">&#x5B57;&#x53F7; &#x00B7; &#x4E0D;&#x6539;&#x53D8;&#x6B63;&#x6587;&#x5185;&#x5BB9;</text><div class="font-segments" style="width:{{contentW}};"><div class="font" for="{{(i,item) in fonts}}" @click="selectFont(item.key)" style="width:{{segmentW}};background-color:{{item.background}};"><text class="font-label" style="width:{{segmentW}};color:{{item.color}};">{{item.label}}</text></div></div></list-item>
   <list-item if="{{isTools}}" class="tool-block" style="width:{{contentW}};height:{{toolBarH+toolCaptionH}};">
    <stack class="source-toolbar" style="width:{{contentW}};height:{{toolBarH}};">
     <image src="{{toolBarImage}}" style="left:0px;top:0px;width:{{contentW}};height:{{toolBarH}};"></image>
     <div class="tool-hit" @click="action('cursor-left')" style="left:0px;top:0px;width:{{toolPartW}};height:{{toolBarH}};"></div>
     <div class="tool-hit" @click="action('type')" style="left:{{toolPartW}};top:0px;width:{{toolPartW}};height:{{toolBarH}};"><image src="{{typeIcon}}" style="width:{{typeIconSize}};height:{{typeIconSize}};"></image></div>
     <div class="tool-hit" @click="action('clipboard')" style="left:{{2*toolPartW}};top:0px;width:{{toolPartW}};height:{{toolBarH}};"></div>
     <div class="tool-hit" @click="action('cursor-right')" style="left:{{3*toolPartW}};top:0px;width:{{toolPartW}};height:{{toolBarH}};"></div>
    </stack>
    <div class="tool-labels" style="width:{{contentW}};height:{{toolCaptionH}};"><text class="tool-caption" style="width:{{toolPartW}};">&#x524D;&#x79FB;</text><text class="tool-caption" style="width:{{toolPartW}};">&#x7C7B;&#x578B;</text><text class="tool-caption" style="width:{{toolPartW}};">&#x526A;&#x5207;&#x677F;</text><text class="tool-caption" style="width:{{toolPartW}};">&#x540E;&#x79FB;</text></div>
   </list-item>
   <list-item class="menu-row" for="{{(i,item) in rows}}" @click="action(item.action)" style="width:{{contentW}};height:{{rowH}};"><image class="icon" src="{{item.icon}}"></image><text class="row-label" style="width:{{rowTextW}};height:{{rowFont*1.5}};font-size:{{rowFont}};color:{{item.color}};">{{item.label}}</text></list-item>
   <list-item class="hint-box" if="{{showHints}}" style="width:{{contentW}};height:{{hintH}};"><text class="hint" style="width:{{contentW}};">{{hint1}}</text><text class="hint" style="width:{{contentW}};">{{hint2}}</text></list-item>
   <list-item class="dialog" if="{{showDialog}}" style="width:{{contentW}};height:{{dialogH}};"><image src="{{dialogIcon}}" style="width:{{dialogIconSize}};height:{{dialogIconSize}};"></image><text class="dialog-title" style="width:{{contentW}};height:{{dialogTitleH}};">{{dialogText}}</text><text class="dialog-hint" style="width:{{contentW}};height:{{dialogHintH}};">{{dialogHint1}}</text><text class="dialog-hint" style="width:{{contentW}};height:{{dialogHintH}};">{{dialogHint2}}</text></list-item>
   <list-item class="empty-box" if="{{showEmpty}}" style="width:{{contentW}};height:60px;"><text class="empty-text" style="width:{{contentW}};">{{emptyText}}</text></list-item>
  </list>
  <div class="dock" style="left:{{dockX}};top:{{dockY}};width:{{dockW}};height:{{hit}};">
   <div class="dock-control" @click="action(dockLeftAction)" style="width:{{dockPartW}};height:{{hit-2}};"><image class="icon" if="{{showDockIcon}}" src="{{dockLeftIcon}}"></image><text class="dock-label" style="height:{{dockLabelH}};">{{dockLeftLabel}}</text></div>
   <div class="dock-divider" if="{{showDockRight}}" style="height:{{hit-2}};"></div>
   <div class="dock-control" if="{{showDockRight}}" @click="action(dockRightAction)" style="width:{{dockPartW}};height:{{hit-2}};"><text class="dock-gold" style="height:{{dockLabelH}};">{{dockRightLabel}}</text></div>
  </div>
  <text class="error" if="{{showMessage}}" style="left:{{contentX}};top:{{dockY-26}};width:{{contentW}};">{{message}}</text>
 </stack>
</stack>
