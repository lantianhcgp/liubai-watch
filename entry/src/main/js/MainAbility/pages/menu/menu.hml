<stack class="page" @swipe="onSwipe">
 <div class="loading" if="{{ !ready }}" @click="retry"><text>{{ message }}</text></div>
 <stack class="surface" if="{{ ready }}" style="width: {{ w }}px; height: {{ h }}px;">
 <list ref="crown" @scrollend="onScrollEnd" style="left:0px; top:0px; width:{{ w }}px; height:{{ h }}px;"><list-item style="width:{{ w }}px; height:{{ h+1 }}px;"></list-item></list>
 <div class="header" style="left: {{ hx }}px; top: {{ hy }}px; width: {{ hw }}px; height: {{ hit }}px;"><div class="hit" @click="back" style="width: {{ hit }}px; height: {{ hit }}px;"><image src="/common/icons/back_warm.png" style="width:24px;height:24px;"></image></div><text class="title" style="width: {{ hw-hit }}px;">{{ title }}</text></div>
 <text class="font-heading" if="{{ mode === 'read' }}" style="left:{{contentX}}px;top:{{fontLabelY}}px;width:{{contentW}}px;height:24px;">{{fontLabel}}</text>
 <div class="fonts" if="{{ mode === 'read' }}" style="left: {{ contentX }}px; top: {{ fontY }}px; width: {{ contentW }}px; height: 46px;"><div class="font" for="{{ (i, f) in fonts }}" @click="setFont(f.key)" style="width: {{ fontW }}px; height: 46px;background-color:{{font===f.key?'#252c27':'#121816'}};"><text class="font-label" style="color:{{font===f.key?'#e6c78c':'#adb1a9'}};">{{ f.label }}</text></div></div>
 <div class="row" for="{{ (i, r) in visibleRows }}" @click="activate(r.action)" style="left: {{ contentX }}px; top: {{ listY+i*rowH }}px; width: {{ contentW }}px; height: {{ rowH }}px;"><image src="{{'/common/icons/'+r.icon+'_warm.png'}}" style="width:22px;height:22px;"></image><div class="row-copy" style="width: {{ contentW-42 }}px; height:{{rowH}}px;"><text class="label" style="width: {{ contentW-42 }}px;">{{ r.title }}</text><text class="subtitle" style="width:{{contentW-42}}px;" if="{{r.subtitle}}">{{r.subtitle}}</text></div></div>
 <text class="hint" if="{{hint}}" style="left:{{contentX}}px;top:{{hintY}}px;width:{{contentW}}px;height:29px;">{{hint}}</text>
 <div class="pagination" if="{{rows.length>slots}}" style="left: {{ contentX }}px; top: {{ dockY }}px; width: {{ contentW }}px; height: 44px;"><div class="step" @click="prev" style="width: {{ contentW/2 }}px; height:44px;"><image src="/common/icons/back_muted.png" style="width:24px;height:24px;"></image></div><div class="step" @click="next" style="width: {{ contentW/2 }}px; height:44px;"><image src="/common/icons/right_muted.png" style="width:24px;height:24px;"></image></div></div>
 <div if="{{ message }}" class="notice" @click="retry" style="left: {{ contentX }}px; top: {{ dockY }}px; width: {{ contentW }}px; height:44px;"><text class="message">{{ message }}</text></div>
 </stack>
</stack>
